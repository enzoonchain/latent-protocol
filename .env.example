# Latent Protocol — client-side configuration
#
# These are the only variables the adapters read. Normal setup writes
# ~/.latent-protocol/config.json via `npx latent-protocol init`; anything set
# here overrides that file, which makes it useful for CI, containers, and
# development against the mock ad server.

# Ad server base URL. Point this at the local mock while developing:
#   node tools/mock-ad-server.mjs
ADS_SERVER=http://127.0.0.1:8899

# EVM address earnings are credited to and paid out to.
ADS_WALLET=0x0000000000000000000000000000000000000000

# Master off switch for every adapter. "false", "0" or "no" disables ads.
ADS_ENABLED=true

# Show an ad every N eligible messages (footer-style adapters).
ADS_FREQUENCY=1

# Seconds before the Claude Code status line rotates to a new ad.
ADS_STATUSLINE_ROTATE=10

# Force a platform instead of auto-detecting: hermes | telegram | cli | mcp
# LATENT_PLATFORM=cli

# Override where the Hermes WebUI static/ directory lives, when auto-detection
# cannot find it.
# HERMES_WEBUI_ROOT=/path/to/hermes/static

# Point the OpenClaw installer at a plugin build other than the bundled one.
# LATENT_OPENCLAW_PLUGIN=/path/to/openclaw-plugin
