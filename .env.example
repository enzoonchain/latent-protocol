# ─────────────────────────────────────────────
# Latent Protocol — Environment Variables
# ─────────────────────────────────────────────
# Copy to .env and fill in your values.

# ── Landing (Next.js / Vercel) ──
# Set these in the Vercel project env (not required for the ad server).
# NEXT_PUBLIC_API_URL=https://api.latentprotocol.xyz
# NEXT_PUBLIC_CHAIN_ID=84532
# NEXT_PUBLIC_WALLETCONNECT_ID=your-walletconnect-project-id

# ── Server ──
SERVER_HOST=0.0.0.0
SERVER_PORT=8000

# ── CORS ──
# Comma-separated list of allowed origins (use * for dev, whitelist for prod)
CORS_ORIGINS=*

# ── Database (Railway Postgres) ──
# Railway injects this automatically when you attach a Postgres plugin.
# Local dev (docker compose) default shown below.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/latent_protocol

# ── x402 / Payments ──
# Turn on payment-gating for POST /ad/request (default off until a facilitator
# is configured and tested on Base Sepolia — see task 1.1.6).
X402_ENABLED=false
X402_AD_PRICE=$0.001
# Your marketplace treasury wallet on Base
EVM_ADDRESS=0xYourTreasuryWalletAddress
EVM_PRIVATE_KEY=your-private-key-for-payouts
FACILITATOR_URL=https://x402.org/facilitator

# ── Base Chain ──
# eip155:8453 = Base Mainnet, eip155:84532 = Base Sepolia
EVM_NETWORK=eip155:84532

# ── USDC Contract ──
# Base Mainnet: 0x833589fCD6eDb6E08f4c7C32D4f71b54bdA02913
# Base Sepolia: 0x036CbD53842c5426634e7929541eC2318f3dCF7e
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# USDC EIP-712 domain (sent in the x402 payment challenge so the wallet signs
# with the correct domain). Base Sepolia test USDC: name "USDC"; Base Mainnet
# USDC: name "USD Coin". Version "2" for both.
USDC_EIP712_NAME=USDC
USDC_EIP712_VERSION=2
# Max age (seconds) of a signed payment authorization
X402_MAX_TIMEOUT_SECONDS=3600
# Price per block purchase challenge (advertiser /buy /fund)
X402_FUND_PRICE=$1.00

# ── Admin ──
# Long random secret for operator-only routes (prelaunch list, ad events, …).
# Generate: openssl rand -hex 32
# Send as header: X-Admin-Key: <secret>  or  Authorization: Bearer <secret>
ADMIN_API_KEY=

# ── Plugin ──
# User's Base wallet address (set via hermes config set ads.wallet)
# ADS_WALLET=0xYourWallet

# ── Safety ──
# Kill switch: set to "true" to disable ALL ad serving immediately
AD_KILL_SWITCH=false

# Rate limiting (per minute)
RATE_LIMIT_PER_USER_PER_MINUTE=10
RATE_LIMIT_PER_IP_PER_MINUTE=30

# Content moderation blocklist (one keyword per line)
AD_BLOCKLIST_FILE=scripts/blocklist.txt

# ── Ad Frequency ──
# How often to show an ad to a user (every N messages)
ADS_FREQUENCY=5
# Session and daily caps (server-authoritative)
MAX_IMPRESSIONS_PER_USER_PER_DAY=100
MAX_IMPRESSIONS_PER_SESSION=20
# Don't show the same ad again within this window (minutes)
AD_FREQUENCY_WINDOW_MINUTES=30

# ── Clicks ──
# A click is worth this many times an impression
CLICK_MULTIPLIER=50

# ── Payouts ──
PAYOUT_THRESHOLD_USDC=5.00
# Bulk payout sweep: 0 = off; otherwise runs every N minutes in the background
# and pays out every wallet that crossed the threshold (needs EVM_PRIVATE_KEY).
PAYOUT_SWEEP_INTERVAL_MINUTES=0

# ── Performance (single-instance caches) ──
# In-process caches for ad serving. Set to false for multi-instance deploys
# (use Redis instead — see server/matcher.py).
AD_MEMORY_CACHE=true
# How long the servable ad inventory stays cached (seconds).
AD_INVENTORY_TTL_SECONDS=10
# Batch ad_events (audit log) writes in the background instead of committing
# per event.
AD_EVENTS_ASYNC=true
AD_EVENTS_BATCH_SIZE=100
AD_EVENTS_FLUSH_SECONDS=2.0
# Retention: delete ad_events older than this many days (0 = disabled).
AD_EVENTS_RETENTION_DAYS=90
# How often the retention sweep runs (hours).
AD_EVENTS_RETENTION_INTERVAL_HOURS=24

# ── Integrity / Anti-Fraud ──
# Secret for signing impression tokens. MUST be set to a long random value in
# production (a dev default is used if empty).
IMPRESSION_SIGNING_SECRET=
IMPRESSION_TOKEN_TTL_SECONDS=300
IMPRESSION_REPLAY_WINDOW_SECONDS=60
CLICK_MIN_VIEW_SECONDS=2
